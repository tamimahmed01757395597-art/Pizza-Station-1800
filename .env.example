# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or any file containing real credentials.

# Public Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase publishable/anon key (safe to expose; protected by RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Public site URL used for auth redirects and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Name of the single IP header your CDN/reverse proxy OVERWRITES on every
# request (one of: cf-connecting-ip, x-vercel-forwarded-for, fastly-client-ip,
# x-real-ip, x-forwarded-for). Leave empty on direct deployments: client-supplied
# headers are never trusted and all callers share one conservative bucket.
RATE_LIMIT_IP_HEADER=

# Server-only email delivery credentials. Leave empty to disable email sending.
# Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google Analytics 4 measurement ID (public). Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry DSNs. The NEXT_PUBLIC_ one is browser-safe; the other is server-only.
# Leave both empty to disable error reporting.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Direct Postgres connection string used only by the scheduled backup workflow.
# Never prefix with NEXT_PUBLIC_ and never commit its value.
DATABASE_URL=
